# Copy to .env next to docker-compose.yml. Never commit the filled-in file.
# Apify (Google name search, bounceverify, pipelinelabs): console.apify.com > Settings > API & Integrations
APIFY_TOKEN=
# Optional: MillionVerifier replaces bounceverify when set (cheaper at volume).
MILLIONVERIFIER_API_KEY=
# Price per check of your MillionVerifier credit pack, so the funnel shows real cost (e.g. 0.0004).
MV_PRICE_USD=
# Shared secret between n8n and this API (any long random string: openssl rand -hex 24).
LEADS_API_TOKEN=
# Name of the n8n stack's Docker network (docker network ls).
N8N_NETWORK=vera_default
