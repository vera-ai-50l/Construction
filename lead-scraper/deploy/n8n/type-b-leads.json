    {
      "id": "6c5b0ff7-d17e-44b4-8ef5-c0d7060db07c",
      "name": "Get scored leads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        200
      ],
      "parameters": {
        "url": "=http://leads:8787/runs/{{ $json.id }}/leads.json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ON_IMPORT",
          "name": "Leads API"
        }
      }
    },
    {
      "id": "56ddc42e-b62c-401f-8c0b-5900dd0e335b",
      "name": "One row per lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// The API returns an array of scored leads; n8n may hand it over as one item or many.\nconst run = $('Check run').first().json;\nconst rows = $input.all().flatMap((i) => (Array.isArray(i.json) ? i.json : Array.isArray(i.json.data) ? i.json.data : [i.json]));\nreturn rows.map((r) => ({ json: { run_date: (run.finished_at || \"\").slice(0, 10), run_id: run.id, ...r } }));"
      }
    },
    {
      "id": "b76b4c59-a6b7-4563-83fe-281192039f20",
      "name": "Google Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1680,
        200
      ],
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "PASTE_YOUR_GOOGLE_SHEET_URL"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Type B leads"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [
            "domain"
          ],
          "schema": []
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_ON_IMPORT",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "id": "28a73cc3-f316-4085-8170-fbeaf3a10668",
      "name": "Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const run = $('Check run').first().json;\nreturn [{ json: { run_id: run.id, leads: run.leads, with_named_email: run.with_named_email, cost_usd: run.cost_usd, rows_written: $input.all().length, funnel: run.funnel } }];"
      }
    },
    {
      "id": "e75ed6af-f61d-4097-842f-4ceedbdeda39",
      "name": "Setup notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -120
      ],
      "parameters": {
        "width": 760,
        "height": 280,
        "content": "## Leads: Type B (funded AI SaaS), weekly\nRuns the type_b lead pipeline (no teardowns) and writes the scored leads, with remarks, to the Google Sheet tab \"Type B leads\" (rows are updated by domain).\n\n1. Create a **Header Auth** credential named \"Leads API\": name `Authorization`, value `Bearer <LEADS_API_TOKEN from deploy/.env>`; select it in the three HTTP nodes.\n2. Connect Google Sheets in **Google Sheet** and paste your sheet URL. Create the tab first; the header row is written on the first run.\n3. The leads API must run on the same Docker network (lead-scraper/deploy). Test with **Run now**; a run takes 20-40 minutes."
      }
    }
  ],
