          ],
          "schema": []
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_ON_IMPORT",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "id": "b6ec070c-240b-4066-8d73-17fbd249806d",
      "name": "Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const run = $('Check run').first().json;\nreturn [{ json: { run_id: run.id, leads: run.leads, with_named_email: run.with_named_email, cost_usd: run.cost_usd, rows_written: $input.all().length, funnel: run.funnel } }];"
      }
    },
    {
      "id": "1c36e161-1bd2-4114-82fa-d2b4cff8a480",
      "name": "Setup notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -120
      ],
      "parameters": {
        "width": 760,
        "height": 280,
        "content": "## Leads: Type B hiring a designer (job-post signal), weekly\nRuns the type_b_jobs lead pipeline (no teardowns) and writes the scored leads, with remarks, to the Google Sheet tab \"Type B leads - job posts\" (rows are updated by domain).\n\n1. Create a **Header Auth** credential named \"Leads API\": name `Authorization`, value `Bearer <LEADS_API_TOKEN from deploy/.env>`; select it in the three HTTP nodes.\n2. Connect Google Sheets in **Google Sheet** and paste your sheet URL. Create the tab first; the header row is written on the first run.\n3. The leads API must run on the same Docker network (lead-scraper/deploy). Test with **Run now**; a run takes 20-40 minutes."
      }
    }
