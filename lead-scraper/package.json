{
  "name": "lead-scraper",
  "private": true,
  "type": "module",
  "description": "Finds and enriches redesign leads for the ICPs in the ICP research report.",
  "scripts": {
    "leads": "NODE_USE_ENV_PROXY=1 node --no-warnings src/cli.mjs",
    "test": "node --test test/*.test.mjs",
    "teardown": "NODE_USE_ENV_PROXY=1 node --no-warnings src/teardown-cli.mjs",
    "login": "node src/login.mjs",
    "pipeline": "NODE_USE_ENV_PROXY=1 node --no-warnings src/pipeline.mjs",
    "serve": "node --no-warnings src/server.mjs",
    "sheet": "node --no-warnings src/lead-sheet.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "axe-core": "4.14.1",
    "cheerio": "1.2.0",
    "exceljs": "4.4.0",
    "playwright": "1.63.0",
    "zod": "4.6.7"
  }
}
