  "name": "Vera 05 · 07 Open items after the visit",
  "nodes": [
    {
      "id": "23e0004b-6472-4c52-8ac2-40447182a97c",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -620
      ],
      "parameters": {
        "content": "## Vera 05 · 07 Open items after the visit\nEvery morning: reminders for items due, escalation for critical items overdue. The contractor replies to the reminder with a photo; the engineer approves it from the photo, not another visit.\n\nGenerated from `n8n/mobilise/workflows.mjs`. Edit there and rebuild; edits made here are overwritten on the next import.\nEach node's note says what it does and which guardrails it carries.",
        "width": 720,
        "height": 220,
        "color": 4
      }
    },
    {
      "id": "e723bb57-2517-41e7-8912-5581d03023a6",
      "name": "Every morning 9 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "notes": "IST.",
      "notesInFlow": false
    },
    {
      "id": "0c2a196e-dc12-445a-8e07-df502e76142d",
      "name": "Items due or overdue",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        280,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select oi.id, oi.mobilisation_id, json_build_object('id', oi.id, 'line', oi.line_code, 'severity', oi.severity, 'text', oi.text, 'finding', oi.finding, 'due_on', oi.due_on::text) as item,\n  mo.project, current_date::text as today,\n  (select id from contacts where mobilisation_id = oi.mobilisation_id and role = 'contractor' limit 1) as contact_id,\n  (select id from contacts where mobilisation_id = oi.mobilisation_id and role = 'project_head' limit 1) as head_contact_id\nfrom open_items oi join mobilisations mo on mo.id = oi.mobilisation_id where oi.status = 'open' and oi.due_on <= current_date;",
        "options": {}
      },
      "notes": "Only items that are due.\nGuardrails: retry",
      "notesInFlow": false,
      "credentials": {
        "postgres": {
          "id": "veraPostgres01",
          "name": "Vera Postgres"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "4cce61a4-a348-426f-8303-55149129fa2f",
      "name": "Each item",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        560,
        0
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "notes": "One at a time.",
      "notesInFlow": false
    },
    {
      "id": "7f10a54b-98fe-451c-8b2f-a56f7a90ded0",
      "name": "Reminder or escalate?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        -100
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Reminder or escalate?: generated from n8n/mobilise/logic.mjs reminderPlan. Edit there, then rebuild.\nconst __fn = function reminderPlan(input) {\n  const today = String(input.today || new Date().toISOString().slice(0, 10))\n  const it = input.item || {}\n  const overdueDays = Math.round((Date.parse(today) - Date.parse(it.due_on)) / 86400000)\n  const who = it.severity === 'critical' && overdueDays >= 1 ? 'escalate' : 'contractor'\n  const text = (overdueDays > 0 ? '⏰ Overdue by ' + overdueDays + ' day' + (overdueDays > 1 ? 's' : '') : '📌 Due today') + ': ' + it.line + ' ' + it.text +\n    (it.finding ? '\\nFinding: ' + it.finding : '') + '\\nReply to *this message* with a photo once it is fixed. The engineer approves it from the photo.'\n  return {\n    ...input, who, overdue_days: overdueDays,\n    request: {\n      body: { type: 'text', text: { preview_url: false, body: text } },\n      template: { name: 'vera_mob_open_item', language: 'en', params: [it.line, it.text, it.due_on] },\n    },\n    escalation: who === 'escalate' ? (input.project || 'Site') + ': critical item ' + it.line + ' is ' + overdueDays + ' day(s) overdue. ' + it.text : '',\n  }\n};\nconst item = $input.item;\nlet input = { ...item.json };\nconst out = __fn(input);\nreturn item.binary ? { json: out, binary: item.binary } : { json: out };"
      },
      "notes": "Critical and overdue → the project head hears about it.",
      "notesInFlow": false
    },
