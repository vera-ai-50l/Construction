    {
      "id": "1808ae69-d5a5-49d6-8a3a-9d6d931c7595",
      "name": "Check Meta signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Why Code: needs the raw body bytes and a constant-time compare (crypto).\nconst crypto = require('crypto');\nconst item = $input.first();\nconst raw = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst secret = $env.VERA_WA_APP_SECRET || '';\nconst want = 'sha256=' + crypto.createHmac('sha256', secret).update(raw).digest('hex');\nconst got = String((item.json.headers || {})['x-hub-signature-256'] || '');\nconst ok = !!secret && got.length === want.length && crypto.timingSafeEqual(Buffer.from(got), Buffer.from(want));\nlet body = null;\ntry { body = JSON.parse(raw.toString('utf8')); } catch (e) { body = null; }\nreturn [{ json: { ok: ok && body !== null, body, body_sha: crypto.createHash('sha256').update(raw).digest('hex') } }];"
      },
      "notes": "HMAC of the raw body with the app secret. Anything not signed by Meta stops here.\nGuardrails: auth, error-out",
      "notesInFlow": false,
      "onError": "continueErrorOutput"
    },
