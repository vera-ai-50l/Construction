# Copy to .env on the server. Never commit the filled-in file.
N8N_DOMAIN=n8n.example.com
ACME_EMAIL=you@example.com
# generate once with: openssl rand -hex 32  (keep a copy; credentials cannot be decrypted without it)
N8N_ENCRYPTION_KEY=

# Desk 05 One-day Mobilisation (see docs/desk-05/README.md)
VERA_WA_APP_SECRET=            # Meta app > Settings > Basic > App secret (signs every webhook)
VERA_WA_VERIFY_TOKEN=          # any long random string; paste the same into Meta's webhook settings
VERA_WA_PHONE_NUMBER_ID=       # WhatsApp > API setup > Phone number ID
VERA_WALK_SECRET=              # openssl rand -hex 32 (signs the engineer's walk links)
VERA_WALK_URL=https://vera.example.com/walk
VERA_FILES_URL=https://files.vera.example.com   # signed-link service for report PDFs
VERA_S3_BUCKET=vera-evidence-mumbai
VERA_OPS_EMAIL=ops@example.com
VERA_OPS_FROM=vera@example.com
